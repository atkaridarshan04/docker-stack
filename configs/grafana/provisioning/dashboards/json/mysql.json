{
  "id": null,
  "uid": "mysql-overview",
  "title": "MySQL",
  "tags": [
    "mysql",
    "database"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Uptime",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mysql_global_status_uptime{job=\"mysqld-exporter\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Connections",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{job=\"mysqld-exporter\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Questions/s",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_questions{job=\"mysqld-exporter\"}[2m])",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Slow Queries/s",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries{job=\"mysqld-exporter\"}[2m])",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "InnoDB Buffer Pool",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mysql_global_variables_innodb_buffer_pool_size{job=\"mysqld-exporter\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Aborted Connections",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_aborted_connects{job=\"mysqld-exporter\"}[5m])",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Query Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_commands_total{job=\"mysqld-exporter\", command=\"select\"}[2m])",
          "legendFormat": "SELECT",
          "refId": "A"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{job=\"mysqld-exporter\", command=\"insert\"}[2m])",
          "legendFormat": "INSERT",
          "refId": "B"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{job=\"mysqld-exporter\", command=\"update\"}[2m])",
          "legendFormat": "UPDATE",
          "refId": "C"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{job=\"mysqld-exporter\", command=\"delete\"}[2m])",
          "legendFormat": "DELETE",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "links": [
            {
              "title": "View MySQL Error Logs",
              "url": "/d/loki-container-logs/container-logs?var-container=mysql&${__url_time_range}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Connections Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{job=\"mysqld-exporter\"}",
          "legendFormat": "Connected",
          "refId": "A"
        },
        {
          "expr": "mysql_global_status_threads_running{job=\"mysqld-exporter\"}",
          "legendFormat": "Running",
          "refId": "B"
        },
        {
          "expr": "mysql_global_variables_max_connections{job=\"mysqld-exporter\"}",
          "legendFormat": "Max Allowed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          },
          "links": [
            {
              "title": "View MySQL Error Logs",
              "url": "/d/loki-container-logs/container-logs?var-container=mysql&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Max Allowed"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "InnoDB Buffer Pool Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mysql_global_status_buffer_pool_pages{job=\"mysqld-exporter\", state=\"data\"} * mysql_global_status_innodb_page_size{job=\"mysqld-exporter\"}",
          "legendFormat": "Data",
          "refId": "A"
        },
        {
          "expr": "mysql_global_status_buffer_pool_pages{job=\"mysqld-exporter\", state=\"free\"} * mysql_global_status_innodb_page_size{job=\"mysqld-exporter\"}",
          "legendFormat": "Free",
          "refId": "B"
        },
        {
          "expr": "mysql_global_status_buffer_pool_dirty_pages{job=\"mysqld-exporter\"} * mysql_global_status_innodb_page_size{job=\"mysqld-exporter\"}",
          "legendFormat": "Dirty",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          },
          "links": [
            {
              "title": "View MySQL Error Logs",
              "url": "/d/loki-container-logs/container-logs?var-container=mysql&${__url_time_range}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_bytes_received{job=\"mysqld-exporter\"}[2m])",
          "legendFormat": "Received",
          "refId": "A"
        },
        {
          "expr": "rate(mysql_global_status_bytes_sent{job=\"mysqld-exporter\"}[2m])",
          "legendFormat": "Sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "links": [
            {
              "title": "View MySQL Error Logs",
              "url": "/d/loki-container-logs/container-logs?var-container=mysql&${__url_time_range}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Slow Query Log",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "{job=\"mysql-slow\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}