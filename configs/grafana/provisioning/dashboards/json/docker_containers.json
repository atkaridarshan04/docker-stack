    },
    {
      "id": 10,
      "title": "Container Resource Summary",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".+\"}[2m]) * 100",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\".+\"}",
          "legendFormat": "{{name}}",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\".+\"}[2m])",
          "legendFormat": "{{name}}",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\".+\"}[2m])",
          "legendFormat": "{{name}}",
          "refId": "D",
          "instant": true
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPU %"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Memory"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Net In"
              },
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Net Out"
              },
              {
                "id": "unit",
