        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\"$container\"}[2m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          },
          "links": [
            {
              "title": "View Logs for ${__series.name}",
              "url": "/d/loki-container-logs/container-logs?var-container=${__series.name}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "tooltip": {
